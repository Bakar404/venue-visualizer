# No API keys are needed. Venue Visualizer drives the AI CLIs you are already logged into.
# Optional overrides:
VV_DATA_DIR=./data
VV_API_URL=http://localhost:8000
VV_DEFAULT_BRAIN=auto        # auto | claude | codex | copilot | kimi | mock
VV_DEFAULT_ENGINE=auto       # auto | copilot | codex | mflux | scene3d | mock
VV_COPILOT_MODEL=            # optional chat model for copilot (e.g. gpt-6.1-sol); empty = CLI default
VV_MFLUX_MODEL=flux2-klein-4b
VV_WEB_URL=http://localhost:3000   # used by scene3d engine for headless rendering

{
  "name": "@vv/schema",
  "version": "0.1.0",
  "private": true,
  "description": "JSON Schemas (source of truth) for DesignSpec, VenueSpec and VenueResearch, the API's OpenAPI document, plus generated TypeScript types.",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./design-spec.schema.json": "./design-spec.schema.json",
    "./venue.schema.json": "./venue.schema.json",
    "./venue-research.schema.json": "./venue-research.schema.json",
    "./openapi.json": "./openapi.json",
    "./openapi": "./openapi.ts"
  },
  "scripts": {
    "generate": "node generate.mjs"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^16.0.0",
    "openapi-typescript": "^7.13.0"
  },
  "license": "MIT"
}

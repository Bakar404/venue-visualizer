{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://venue-visualizer.local/schema/venue-research.schema.json",
  "title": "VenueResearch",
  "description": "What the venue-finder agent found on the public web about a real venue. Everything here is a suggestion with a source; the user confirms before it becomes a Venue/Space. Rules found online are NOT authoritative until the user accepts them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["query", "matches"],
  "properties": {
    "query": { "type": "string" },
    "matches": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "confidence", "sources"],
        "properties": {
          "name": { "type": "string" },
          "address": { "type": ["string", "null"] },
          "website": { "type": ["string", "null"], "format": "uri" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "summary": { "type": ["string", "null"] },
          "style": { "type": ["string", "null"] },
          "spaces": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "description": { "type": ["string", "null"] },
                "capacity_seated": { "type": ["integer", "null"] },
                "capacity_standing": { "type": ["integer", "null"] },
                "length_ft": { "type": ["number", "null"] },
                "width_ft": { "type": ["number", "null"] },
                "ceiling_ft": { "type": ["number", "null"] },
                "walls": { "type": ["string", "null"] },
                "floor": { "type": ["string", "null"] },
                "windows": { "type": ["string", "null"] },
                "fixtures": { "type": "array", "items": { "type": "string" } },
                "photos": {
                  "type": "array",
                  "maxItems": 12,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["url", "source_page"],
                    "properties": {
                      "url": { "type": "string", "format": "uri" },
                      "source_page": { "type": "string", "format": "uri" },
                      "caption": { "type": ["string", "null"] },
                      "credit": { "type": ["string", "null"] }
                    }
                  }
                },
                "source": { "type": ["string", "null"], "format": "uri" }
              }
            }
          },
          "rules_found": {
            "type": "array",
            "description": "Policies the agent saw published (e.g. 'flameless candles only'). Suggestions only.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "source"],
              "properties": {
                "text": { "type": "string" },
                "maps_to": { "type": ["string", "null"], "enum": ["live_candles", "fog", "confetti", "sparklers", "adhesives", "nails", "ceiling_draping", null] },
                "allowed": { "type": ["boolean", "null"] },
                "source": { "type": "string", "format": "uri" }
              }
            }
          },
          "provided_items": { "type": "array", "items": { "type": "string" } },
          "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } }
        }
      }
    },
    "notes": { "type": ["string", "null"] }
  }
}
